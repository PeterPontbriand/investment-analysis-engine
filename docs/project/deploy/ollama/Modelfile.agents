FROM qwen2.5-coder:32b-instruct-q5_K_M

# Set 8,192 token context window (fits in VRAM with q8_0 KV cache)
PARAMETER num_ctx 8192

# Offload all 64 model layers across GPU 0 + GPU 1
PARAMETER num_gpu 64

# Deterministic parameters for Python/Pandas logic
PARAMETER temperature 0.2
PARAMETER top_p 0.95
PARAMETER repeat_penalty 1.05

SYSTEM "You are an expert AI agent embedded in the financial-data-agents pipeline. You excel at Python 
data manipulation, pandas transformations, financial API ingestion, and strict JSON outputs. Execute 
requests with precision."