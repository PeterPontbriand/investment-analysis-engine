{
  "$defs": {
    "CalculationStatus": {
      "description": "Machine-readable outcome of a calculation attempt.\n\nPure calculators (Slice B) may return:\n\n- ``OK`` — required inputs resolved and calculation completed.\n- ``NOT_APPLICABLE`` — inputs are valid but the selected method is\n  inapplicable (e.g. non-positive EPS or BVPS for the Graham Number).\n- ``INVALID_INPUT`` — supplied value, unit, basis, or method/flag\n  combination is invalid.\n\nResolver/provider layers (Slice C and later) will additionally return:\n\n- ``INPUT_UNAVAILABLE`` — a required input could not be resolved under\n  the requested time boundary.\n- ``PROVIDER_ERROR`` — the configured provider failed in a way that\n  should be distinguished from an absent fact.",
      "enum": [
        "ok",
        "not_applicable",
        "invalid_input",
        "input_unavailable",
        "provider_error"
      ],
      "title": "CalculationStatus",
      "type": "string"
    },
    "DiagnosticPart": {
      "additionalProperties": false,
      "description": "One diagnostics entry that names no provider: a resolver event or the legacy identity entry.",
      "properties": {
        "field_name": {
          "title": "Field Name",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "field_name",
        "stage",
        "outcome",
        "message"
      ],
      "title": "DiagnosticPart",
      "type": "object"
    },
    "GrahamGrowthAssumptionsPart": {
      "additionalProperties": false,
      "description": "The method assumptions the calculation used.",
      "properties": {
        "base_pe": {
          "title": "Base Pe",
          "type": "number"
        },
        "baseline_aaa_yield": {
          "title": "Baseline Aaa Yield",
          "type": "number"
        },
        "growth_multiplier": {
          "title": "Growth Multiplier",
          "type": "number"
        }
      },
      "required": [
        "base_pe",
        "growth_multiplier",
        "baseline_aaa_yield"
      ],
      "title": "GrahamGrowthAssumptionsPart",
      "type": "object"
    },
    "GrahamGrowthInputsPart": {
      "additionalProperties": false,
      "description": "The inputs the method needs, each null when it could not be resolved.",
      "properties": {
        "current_aaa_yield": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedInputPart"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedInputPart"
            },
            {
              "type": "null"
            }
          ]
        },
        "eps": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedInputPart"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_growth": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedInputPart"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "eps",
        "expected_growth",
        "current_aaa_yield",
        "current_price"
      ],
      "title": "GrahamGrowthInputsPart",
      "type": "object"
    },
    "GrahamGrowthResultPart": {
      "additionalProperties": false,
      "description": "The computed value; null unless the calculation succeeded.",
