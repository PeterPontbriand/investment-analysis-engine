    "QuoteFreshnessPart": {
      "additionalProperties": false,
      "description": "How recent the quote behind a price comparison was.",
      "properties": {
        "evaluated_at": {
          "description": "An ISO 8601 instant with its UTC offset, e.g. +00:00.",
          "format": "date-time",
