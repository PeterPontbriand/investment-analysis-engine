      "title": "GrahamGrowthResultPart",
      "type": "object"
    },
    "InstrumentKind": {
      "description": "Reviewed provider-neutral instrument classifications.",
      "enum": [
        "equity",
        "etf",
        "cryptocurrency"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
