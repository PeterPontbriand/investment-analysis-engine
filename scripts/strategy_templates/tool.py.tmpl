"""The $label strategy's analysis-tool arguments, dependencies and handler."""

from __future__ import annotations

from dataclasses import dataclass

from investment_analysis_engine.orchestrator.analysis_tool_arguments import AnalysisToolArguments
from investment_analysis_engine.orchestrator.tool_runtime import ToolRuntime
from investment_analysis_engine.strategies._shared.tool import tool_context
from investment_analysis_engine.strategies.$module.analyzer import ${Class}Analyzer, ${Class}Result


class ${Class}ToolArguments(AnalysisToolArguments):
    """Validated arguments for the $label analysis."""


@dataclass(frozen=True)
class ${Class}ToolDependencies:
    """The injected $label analyzer."""

    analyzer: ${Class}Analyzer


class ${Class}ToolHandler:
    """Bind the $label analyzer and the shared runtime to the analysis tool."""

    def __init__(self, dependencies: ${Class}ToolDependencies, runtime: ToolRuntime) -> None:
        """Retain the injected analyzer and shared runtime."""
        self._dependencies = dependencies
        self._runtime = runtime

    def __call__(self, **raw_arguments: object) -> ${Class}Result:
        """Validate the arguments and run one $label analysis."""
        arguments = ${Class}ToolArguments.model_validate(raw_arguments)
        context = tool_context(self._runtime, arguments)
        return self._dependencies.analyzer.run_analysis(ticker=arguments.ticker, context=context)
