{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/scripts/agent_stop_hook.py\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
