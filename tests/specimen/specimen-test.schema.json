{
  "$defs": {
    "CalculationStatus": {
      "description": "Machine-readable outcome of a calculation attempt.\n\nPure calculators (Slice B) may return:\n\n- ``OK`` — required inputs resolved and calculation completed.\n- ``NOT_APPLICABLE`` — inputs are valid but the selected method is\n  inapplicable (e.g. non-positive EPS or BVPS for the Graham Number).\n- ``INVALID_INPUT`` — supplied value, unit, basis, or method/flag\n  combination is invalid.\n\nResolver/provider layers (Slice C and later) will additionally return:\n\n- ``INPUT_UNAVAILABLE`` — a required input could not be resolved under\n  the requested time boundary.\n- ``PROVIDER_ERROR`` — the configured provider failed in a way that\n  should be distinguished from an absent fact.",
      "enum": [
        "ok",
        "not_applicable",
        "invalid_input",
        "input_unavailable",
        "provider_error"
      ],
      "title": "CalculationStatus",
      "type": "string"
    },
    "DiagnosticPart": {
      "additionalProperties": false,
      "description": "One diagnostics entry that names no provider: a resolver event or the legacy identity entry.",
      "properties": {
        "field_name": {
          "title": "Field Name",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "field_name",
        "stage",
        "outcome",
        "message"
      ],
      "title": "DiagnosticPart",
      "type": "object"
    },
    "FailureReasonCode": {
      "description": "Stable failure categories a caller may branch on.\n\nA value is never renamed, repurposed or removed within the public contract. New values may be\nadded, so a caller must treat an unrecognized value as a generic failure and use ``status`` for the\ncategory.",
      "enum": [
        "execution_error",
        "historical_quality",
        "provider_error",
        "provider_unreachable",
        "provider_rate_limited",
        "provider_unexpected_response",
        "provider_no_data",
        "configuration_error",
        "no_eligible_observations",
        "invalid_input",
        "invalid_parameter",
        "database_upgrade_required",
        "database_incompatible_schema",
        "database_busy",
        "database_permission_denied",
        "database_invalid_file",
        "database_io_error",
        "database_resources_unavailable",
        "database_initialization_failed",
        "database_migration_failed",
        "invalid_stored_run",
        "unsupported_run_version",
        "watchlist_not_found",
        "watchlist_entry_not_found",
        "watchlist_empty",
        "watchlist_name_conflict",
        "analysis_run_not_found",
        "stored_selection_unreadable",
        "unsupported_projection"
      ],
      "title": "FailureReasonCode",
      "type": "string"
    },
    "InstrumentKind": {
      "description": "Reviewed provider-neutral instrument classifications.",
      "enum": [
        "equity",
        "etf",
        "cryptocurrency"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "InstrumentKindPart": {
      "additionalProperties": false,
      "description": "The instrument-kind evidence a provider returned: the raw provider value and the reviewed kind it maps to.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstrumentKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_value": {
          "title": "Provider Value",
          "type": "string"
        },
        "resolved_at": {
          "description": "An ISO 8601 instant with its UTC offset, e.g. +00:00.",
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "provider_value",
        "provider_id",
        "resolved_at"
      ],
      "title": "InstrumentKindPart",
      "type": "object"
    },
    "ProviderCheckItem": {
      "additionalProperties": false,
      "description": "The verdict for one provider.",
      "properties": {
        "provider_id": {
          "description": "The provider the test request went to.",
          "title": "Provider Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ProviderCheckVerdict"
        }
      },
      "required": [
        "provider_id",
        "verdict"
      ],
      "title": "ProviderCheckItem",
      "type": "object"
    },
    "ProviderCheckVerdict": {
      "description": "What a test request to a provider found: five provider conditions, or that nothing was checked.",
      "enum": [
        "healthy",
        "unreachable",
        "rate_limited",
        "unexpected_response",
        "no_data",
        "not_checked"
      ],
      "title": "ProviderCheckVerdict",
      "type": "string"
    },
    "ProviderDiagnosticPart": {
      "additionalProperties": false,
      "description": "One diagnostics entry for an instrument-profile capability, which names the provider consulted.",
      "properties": {
        "field_name": {
          "title": "Field Name",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "field_name",
        "stage",
        "outcome",
        "message",
        "provider_id"
      ],
      "title": "ProviderDiagnosticPart",
      "type": "object"
    },
    "ProviderFailure": {
      "additionalProperties": false,
      "description": "Why an analysis outcome is a provider failure: one of four codes and the inputs that caused it.\n\nThe same element is carried by the failure envelope and by every document that reports an analysis\noutcome. ``reason_code`` is the single code derived from the kinds in ``inputs``.",
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/ProviderFailureInput"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "reason_code": {
          "$ref": "#/$defs/FailureReasonCode"
        }
      },
      "required": [
        "reason_code",
        "inputs"
      ],
      "title": "ProviderFailure",
      "type": "object"
    },
    "ProviderFailureInput": {
      "additionalProperties": false,
      "description": "One failed input: which provider failed it and what the adapter observed.",
      "properties": {
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The strategy input the failure was recorded against; null when the failure was raised.",
          "title": "Input"
        },
        "kind": {
          "$ref": "#/$defs/ProviderFailureKind"
        },
        "provider_id": {
          "description": "The provider that failed.",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "input",
        "provider_id",
        "kind"
      ],
      "title": "ProviderFailureInput",
      "type": "object"
    },
    "ProviderFailureKind": {
      "description": "What a provider failure was, as observed by the adapter.\n\n``UNREACHABLE``: the service did not serve the request (DNS, connection, timeout, blocking, server errors).\n``RATE_LIMITED``: the service refused the request because it is limiting requests (HTTP 429, or the library's\nrate-limit error). ``UNEXPECTED_RESPONSE``: the service answered, but not in the form the adapter reads.\n``NO_DATA``: the service answered correctly and has nothing for this request.",
      "enum": [
        "unreachable",
        "rate_limited",
        "unexpected_response",
        "no_data"
      ],
      "title": "ProviderFailureKind",
      "type": "string"
    },
    "SecurityIdentityPart": {
      "additionalProperties": false,
      "description": "The identity snapshot a run retains; every descriptive field is null when the provider returned none.",
      "properties": {
        "instrument_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instrument Identifier"
        },
        "instrument_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instrument Name"
        },
        "issuer_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issuer Identifier"
        },
        "listing_venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Listing Venue"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Id"
        },
        "resolved_at": {
          "anyOf": [
            {
              "description": "An ISO 8601 instant with its UTC offset, e.g. +00:00.",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved At"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "instrument_name",
        "listing_venue",
        "issuer_identifier",
        "instrument_identifier",
        "provider_id",
        "resolved_at"
      ],
      "title": "SecurityIdentityPart",
      "type": "object"
    },
    "SpecimenResultPart": {
      "additionalProperties": false,
      "description": "The computed value, its input and the multiplier applied.",
      "properties": {
        "multiplier": {
          "title": "Multiplier",
          "type": "number"
        },
        "scaled": {
          "title": "Scaled",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "multiplier",
        "scaled"
      ],
      "title": "SpecimenResultPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The specimen document, as ``specimen-test --json`` and a replay write it.",
  "properties": {
    "analysis": {
      "const": "specimen",
      "title": "Analysis",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/DiagnosticPart"
          },
          {
            "$ref": "#/$defs/ProviderDiagnosticPart"
          }
        ]
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "effective_as_of": {
      "description": "An ISO 8601 instant with its UTC offset, e.g. +00:00.",
      "format": "date-time",
      "title": "Effective As Of",
      "type": "string"
    },
    "instrument_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstrumentKindPart"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "method": {
      "const": "specimen_method",
      "title": "Method",
      "type": "string"
    },
    "provider_check": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ProviderCheckItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Check"
    },
    "provider_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_as_of": {
      "anyOf": [
        {
          "description": "An ISO 8601 instant with its UTC offset, e.g. +00:00.",
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requested As Of"
    },
    "result": {
      "$ref": "#/$defs/SpecimenResultPart"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "security_identity": {
      "$ref": "#/$defs/SecurityIdentityPart"
    },
    "status": {
      "$ref": "#/$defs/CalculationStatus"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "analysis",
    "method",
    "ticker",
    "status",
    "provider_failure",
    "provider_check",
    "requested_as_of",
    "effective_as_of",
    "security_identity",
    "instrument_kind",
    "result",
    "warnings",
    "limitations",
    "diagnostics"
  ],
  "title": "SpecimenDocument",
  "type": "object"
}
