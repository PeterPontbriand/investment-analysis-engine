"""The CI Probe strategy's replay projector: render a stored run using only the evidence it captured."""

from investment_analysis_engine.core.analysis_status import CalculationStatus
from investment_analysis_engine.reporting.headline import CellKind, Headline, HeadlineCell
from investment_analysis_engine.reporting.replay_inputs import ReplayInputs, ReplayOptions
from investment_analysis_engine.strategies.ci_probe.analyzer import CiProbeResult
from investment_analysis_engine.strategies.ci_probe.presenter import render_ci_probe
from investment_analysis_engine.strategies.ci_probe.selection import CiProbeSelection


def project_ci_probe(
    inputs: ReplayInputs, evidence: CiProbeResult, selection: CiProbeSelection, options: ReplayOptions
) -> str:
    """Reconstruct the CI Probe presentation from stored evidence only."""
    del inputs, selection
    return render_ci_probe(evidence, options.mode)


def headline_ci_probe(result: CiProbeResult) -> Headline:
    """Return the CI Probe cell of the side-by-side refresh table: the calculation always succeeds."""
    del result
    return Headline(cells=(HeadlineCell("probe", "Probe", CellKind.NUMBER, 1.0, "points", CalculationStatus.OK),))
