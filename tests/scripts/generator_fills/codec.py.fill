from datetime import datetime
from investment_analysis_engine.core.tickers import is_normalized_ticker

#: body encode_ci_probe
return {"ticker": evidence.ticker, "effective_as_of": evidence.effective_as_of.isoformat()}

#: body decode_ci_probe
if set(payload) != _FIELDS:
    raise ValueError("CI Probe evidence has unexpected keys.")
ticker, stamp = payload["ticker"], payload["effective_as_of"]
if not isinstance(ticker, str) or not is_normalized_ticker(ticker):
    raise ValueError("CI Probe requires a normalized ticker.")
if not isinstance(stamp, str):
    raise ValueError("CI Probe effective_as_of must be text.")
effective_as_of = datetime.fromisoformat(stamp)
if effective_as_of.utcoffset() is None:
    raise ValueError("CI Probe effective_as_of must be timezone-aware.")
return CiProbeResult(
    ticker=ticker,
    requested_as_of=None,
    effective_as_of=effective_as_of,
    instrument_profile=None,
    execution_status=CalculationStatus.OK,
    reason_code=None,
    reason=None,
    input_failure=None,
    warnings=(),
    diagnostics=(),
)

#: body ci_probe_native_status
del result
return CalculationStatus.OK

#: add _FIELDS
_FIELDS = frozenset({"ticker", "effective_as_of"})
