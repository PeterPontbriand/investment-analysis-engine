"""The CI Probe strategy's fixture composition for the evaluation tier."""

from typing import Final

from investment_analysis_engine.evaluation.fixture_context import FixtureContext, FixtureRequirement
from investment_analysis_engine.strategies.ci_probe.analyzer import CiProbeAnalyzer
from investment_analysis_engine.strategies.ci_probe.selection import CiProbeSelection
from investment_analysis_engine.strategies.ci_probe.tool import CiProbeToolDependencies

FIXTURE_IDS: Final = frozenset({"ci-probe-fixture"})
REQUIREMENT: Final = FixtureRequirement(FIXTURE_IDS, "CI Probe fixture", etf_profile_exempt=False)
"""The strategy needs its own fixture; an ETF profile does not stand in for it."""

SAMPLE_SELECTION: Final = CiProbeSelection()
"""A valid persisted selection of the strategy's reviewed case."""


def compose(context: FixtureContext) -> CiProbeToolDependencies:
    """Build the strategy's dependencies; the calculation needs no provider, so the context is not read."""
    del context
    return CiProbeToolDependencies(analyzer=CiProbeAnalyzer())
