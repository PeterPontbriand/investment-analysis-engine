from datetime import datetime

from investment_analysis_engine.analysis.base_analyzer import require_ticker

#: replace CiProbeResult
@dataclass(frozen=True)
class CiProbeResult:
    """The complete evidence of one CI Probe run."""

    ticker: str
    effective_as_of: datetime

#: body CiProbeAnalyzer.run_analysis
return CiProbeResult(ticker=require_ticker(ticker), effective_as_of=context.effective_as_of)
