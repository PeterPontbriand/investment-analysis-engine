"""The CI Probe strategy's result and analyzer."""

from dataclasses import dataclass
from datetime import datetime

from investment_analysis_engine.analysis.base_analyzer import AnalysisContext, ConfigFreeAnalyzer, require_ticker


@dataclass(frozen=True)
class CiProbeResult:
    """The complete evidence of one CI Probe run."""

    ticker: str
    effective_as_of: datetime


class CiProbeAnalyzer(ConfigFreeAnalyzer[CiProbeResult]):
    """Return the ticker and the run's effective point in time."""

    def run_analysis(self, ticker: str, context: AnalysisContext) -> CiProbeResult:
        """Return the evidence of one CI Probe run for ``ticker``."""
        return CiProbeResult(ticker=require_ticker(ticker), effective_as_of=context.effective_as_of)
